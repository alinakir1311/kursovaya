[Unit]
Description=Avtoritm Django shop
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=avtoritm
Group=avtoritm
WorkingDirectory=/opt/avtoritm/app
EnvironmentFile=/etc/avtoritm.env
ExecStart=/opt/avtoritm/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 2 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/avtoritm

[Install]
WantedBy=multi-user.target
